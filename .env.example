# Copy to .env (or run `python tools/init_env.py`, which does it for you).
# NEVER commit the real .env file.

# --- Required -------------------------------------------------------------
SECRET_KEY=replace-with-64-random-hex-characters
# Password hashes (quote them - they contain $ characters):
ADMIN_PASSWORD_HASH='generated-by-tools/init_env.py'
USER_PASSWORD_HASH='generated-by-tools/init_env.py'

# --- Optional -------------------------------------------------------------
# MUNICIPALITY_NAME=Biratnagar Municipality
# MAP_CENTER=27.4089,86.0732        # lat,lon used by the road/house/survey maps
# MAP_ZOOM=13
# WARD_COUNT=20
# DATA_DIR=/absolute/path/to/data   # default: ./data (outside the web-served static/ folder)
# PARCELS_FILE=land_parcels.web.geojson

# 1 = show built-in demo features when a layer file is missing (never use in production)
# DEMO_MODE=0

# Local development only (Werkzeug debugger = remote code execution if exposed!)
# FLASK_DEBUG=1
# COOKIE_SECURE=0                   # allow login cookies over plain http (default is on unless FLASK_DEBUG=1)

# Deployment
# BEHIND_PROXY=1                    # trust one reverse proxy for client IPs / https
# LOGIN_RATE_LIMIT=5 per minute;30 per hour
# RATELIMIT_STORAGE_URI=redis://localhost:6379   # needed when running several workers
# HOST=127.0.0.1
# PORT=5000
